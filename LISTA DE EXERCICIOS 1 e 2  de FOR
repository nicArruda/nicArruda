#include <stdio.h>
int numero, par, impar;
main(){
	par = 0;
	impar = 0;
	
	for(int i=1; i<=5; i++){
		printf("\nDigite o %d numero: ", i);
		scanf("%i", &numero);
		if((i%2) == 0){
			par++;
		}else{
			impar++;
		}
	
	}
	printf("\nTotal de numeros pares: %i", par);
	printf("\nTotal de numeros impares: %i", impar);
}



