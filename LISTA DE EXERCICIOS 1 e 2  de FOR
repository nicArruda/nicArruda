#include <stdio.h>
float altura, maior, menor;
main(){
	maior = 0;
	menor = 5;
	
	for(int i=1; i<=6; i++){
		printf("\nDigite o %i altura:\n ", i);
		scanf("%f", &altura);
		if(altura > maior){
			maior= altura;
		}
		if(altura < menor){
			menor = altura;
		}
	
	
	}
	printf("\nMaior altura %.2f", maior);
	printf("\nMenor altura %.2f", menor);
}



